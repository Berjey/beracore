# BERACORE — İletişim formu SMTP ayarları
# Bu dosyayı .env.local olarak kopyalayın ve gerçek değerlerle doldurun.
# .env.local gitignore'da — commit'lenmez.

# Sunucu host ve port
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# Port 465 ise true, 587/STARTTLS ise false (boş bırakılırsa port'a göre otomatik)
SMTP_SECURE=false

# SMTP kimlik bilgileri
SMTP_USER=info@beracore.com
SMTP_PASS=your-smtp-password-or-app-password

# Gönderen (MAIL FROM) — kimi sağlayıcı SMTP_USER ile aynı olmasını bekler
SMTP_FROM="BERACORE <info@beracore.com>"

# Bildirimlerin düşeceği adres (çoklu: virgülle)
SMTP_TO=info@beracore.com

# ── Google Analytics (opsiyonel) ─────────────────────────────────────
# GA4 Measurement ID. BOŞ bırakılırsa analytics YÜKLENMEZ, çerez banner'ı
# gösterilmez, CSP tam sıkı kalır. Doldurulursa KVKK çerez onayı sonrası GA aktif olur.
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ─────────────── Yonetim Paneli (Faz A) ───────────────
# Veritabani REPO DISINDA durur; deploy'daki git islemleri dokunamaz.
# Uretim: /var/www/beracore-data/beracore.db  (dizin chmod 700)
DB_PATH=/var/www/beracore-data/beracore.db

# Oturum cerezi imza anahtari. En az 32 karakter, rastgele.
# Uretmek icin: node scripts/hash-password.mjs 'gecici' ciktisindaki AUTH_SECRET satiri
AUTH_SECRET=

# Panel girisi. Parola HASH olarak tutulur, duz metin ASLA yazilmaz.
# Uretmek icin: node scripts/hash-password.mjs 'parolaniz'
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
